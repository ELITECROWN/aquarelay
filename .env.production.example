# Render dashboard values. NEVER put server secrets in VITE_* variables.
DEMO_MODE=false
COOKIE_SECURE=true
EMBEDDED_WORKER=true
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_RENDER
SUPABASE_STORAGE_BUCKET=evidence
STATIC_PATH=../dist
PUBLIC_URL=https://YOUR_SERVICE.onrender.com
CORS_ORIGINS=https://YOUR_SERVICE.onrender.com
# One-time initial administrator. Remove after successful creation.
BOOTSTRAP_ADMIN_EMAIL=YOUR_EMAIL
BOOTSTRAP_ADMIN_NAME=AquaRelay administrator
BOOTSTRAP_ADMIN_PASSWORD=SET_A_UNIQUE_14_CHARACTER_OR_LONGER_PASSWORD
# Optional AI: choose a model with free quota in your Google AI Studio account.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional account recovery and email updates: requires a verified sender domain.
# RESEND_API_KEY=
# EMAIL_FROM=AquaRelay <updates@YOUR_VERIFIED_DOMAIN>
# Free HTTPS alternative: Mailjet, with a verified sender email
# MAILJET_API_KEY=YOUR_MAILJET_API_KEY
# MAILJET_SECRET_KEY=YOUR_MAILJET_SECRET_KEY
# EMAIL_FROM=AquaRelay <YOUR_GMAIL_ADDRESS>
# Browser push: copy generated values from ignored .env.push to Render.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:YOUR_PUBLIC_CONTACT_EMAIL
# Real OSM starter snapshot, after the download succeeds.
# REGISTRY_STARTER_PATH=../fixtures/bengaluru-osm.json
# Institutional delivery stays unavailable until a partner supplies a working endpoint.
HANDOFF_RECIPIENTS_JSON={}
