# Docker Compose defaults are for local demonstration only.
DEMO_MODE=true
POSTGRES_PASSWORD=local-demo-database-password
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
MAP_STYLE_URL=
# Server-only organisation recipient directory. Leave empty when no recipient is connected.
# See docs/CONNECTOR_CONTRACTS.md for the HTTPS/idempotency receipt contract.
HANDOFF_RECIPIENTS_JSON={}
# Direct development: SQLite persists server-side under backend/data.
# DATABASE_URL=sqlite:///./data/aquarelay.sqlite
# STORAGE_PATH=./data/files
# STATIC_PATH=../dist
# External basemap: use a licensed MapLibre style URL and preserve its attribution.
# VITE_MAP_STYLE_URL=https://your-provider.example/style.json
# VITE_PUBLIC_URL=https://your-public-aquarelay.example
# Core workflows require no AI, email, push, tile or geocoder credentials.
